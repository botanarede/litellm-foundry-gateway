# systemd user unit template. Render @REPO_DIR@ with the absolute path of this checkout, e.g.:
#   sed "s|@REPO_DIR@|$PWD|" deploy/litellm-foundry-gateway.service \
#     > ~/.config/systemd/user/litellm-foundry-gateway.service
# ProtectSystem/ProtectHome are intentionally absent: user units silently ignore them on hosts
# that restrict unprivileged user namespaces (e.g. Ubuntu 24.04+ AppArmor defaults).
[Unit]
Description=LiteLLM gateway for Codex and Azure AI Foundry
After=network-online.target

[Service]
EnvironmentFile=%h/.config/litellm-foundry-gateway/gateway.env
# TypeSafe fallback and stray .env hardening; see README "Security notes".
Environment=TYPESAFE_API_BASE=http://127.0.0.1:9
Environment=LITELLM_MODE=PRODUCTION
UnsetEnvironment=TYPESAFE_API_KEY
ExecStartPre=/bin/sh -c 'test -n "$${LITELLM_MASTER_KEY}" || { echo "LITELLM_MASTER_KEY is empty; refusing to start without auth" >&2; exit 1; }'
ExecStartPre=/bin/sh -c 'test "$${TYPESAFE_API_BASE}" = "http://127.0.0.1:9" || { echo "TYPESAFE_API_BASE must stay at the closed local port; refusing to start" >&2; exit 1; }'
ExecStart=%h/.local/share/litellm-foundry-gateway/venv/bin/litellm \
  --config @REPO_DIR@/gateway/config.yaml --host 127.0.0.1 --port 4000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
