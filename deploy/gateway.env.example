# Copy to ~/.config/litellm-foundry-gateway/gateway.env and keep it mode 0600.
# Bare Azure AI Foundry resource URL (no /openai/v1 suffix).
AZURE_FOUNDRY_API_BASE=https://<resource>.openai.azure.com
AZURE_FOUNDRY_API_KEY=
# Decision models (Profile D): the same resource URL plus /providers/microsoft.
AZURE_FOUNDRY_DECISIONS_BASE=https://<resource>.openai.azure.com/providers/microsoft
# Gateway key: sk- prefix plus random hex, e.g. "sk-$(openssl rand -hex 16)".
LITELLM_MASTER_KEY=sk-<32-random-hex>
# Do not add TYPESAFE_API_KEY, TYPESAFE_API_BASE or GEMINI_API_KEY here: the gateway sends nothing
# outside the Foundry resource, and the systemd unit drops TYPESAFE_API_KEY on purpose.
